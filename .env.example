# Google Sheets API
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GSHEET_ID=your-google-sheet-id

# CTgoodjobs CLI (optional - if not set, homepage bootstrap is used)
# CTGOOD_SID=
# CTGOOD_VISITOR_ID=
# CTGOOD_CHANNEL_ID=1

# Candidate name (used in tailor.py summary generation)
CANDIDATE_NAME=Your Name

# Runtime/workspace and gateway
# JOBSEARCH_ROOT=/absolute/path/to/JobSearch_2026
# JOBSFLOW_GATEWAY_ACTIVE=1                 # injected by the unified gateway
# JOBSFLOW_SESSION_ID=                       # optional handoff/session label
# JOBSFLOW_QC_MODE=off                      # off | observe | warn | enforce
# JOBSFLOW_QC_TRACE_PATH=/absolute/path/to/qc-traces

# SOP Control (normally discovered from the checkout; do not disable in production)
# JOBSFLOW_SOPCONTROL_MODE=observe          # observe | warn | enforce
# JOBSFLOW_SOPCONTROL_ROOT=/absolute/path/to/.sopcontrol
# JOBSFLOW_SOPCONTROL_TICKETS=off           # on only when the action policy requires it
# JOBSFLOW_SOPCONTROL_ALLOW_RELAX=0
# JOBSFLOW_SOPCONTROL_TEST=0

# Materials/auditor (optional; the host remains the source of truth)
# JOBSFLOW_AUDITOR_PROVIDER=
# JOBSFLOW_AUDITOR_COMMAND=
# JOBSFLOW_AUDITOR_FAST_COMMAND=
# JOBSFLOW_AUDITOR_STRONG_COMMAND=
# JOBSFLOW_MATERIALS_ALLOW_UNCONFIRMED_RESET=0
# JOBSFLOW_LLM_URL=
# JOBSFLOW_LLM_KEY=
# JOBSFLOW_LLM_MODEL=
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Scan and portal budgets (optional)
# JOBSFLOW_SCAN_AUTO_TICKET=on
# JOBSFLOW_JOBSDB_CDP_PORT=9222
# JOBSFLOW_JOBSDB_CDP_STARTUP_TIMEOUT=30
# JOBSFLOW_JOBSDB_CDP_URL=
# PORTAL_JD_BROWSER=1
# PORTAL_JD_CHANNEL=chrome
# PORTAL_JD_STORAGE_STATE=/absolute/path/to/storage_state.json
# PORTAL_JD_JOBSDB_PROFILE_DIR=
# PORTAL_JD_FAILURE_CACHE_TTL_SECONDS=600
# PORTAL_JD_WAF_WAIT_SECONDS=10
# PLAYWRIGHT_BROWSERS_PATH=

# The scanner sets these internally; they are listed for diagnostics only.
# JOBSFLOW_SCAN_MODE=1
# JOBSFLOW_SCAN_REQUEST_TIMEOUT_MS=12000
# JOBSFLOW_SCAN_MAX_RETRIES=1
# JOBSFLOW_SCAN_MAX_RETRY_DELAY_MS=3000
