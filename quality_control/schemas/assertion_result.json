{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssertionResult",
  "type": "object",
  "required": ["assertion_id", "category", "severity", "status", "message", "blocking"],
  "properties": {
    "assertion_id": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["state", "sop", "artifact", "side_effect", "semantic", "performance"]
    },
    "severity": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "info"]
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "skip", "not_applicable"]
    },
    "message": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "remediation": { "type": "string" },
    "blocking": { "type": "boolean" }
  },
  "additionalProperties": true
}
